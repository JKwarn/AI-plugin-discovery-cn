{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JKwarn/AI-plugin-discovery-cn/main/schemas/taxonomy-file.schema.json",
  "title": "Taxonomy dimension file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "dimension",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dimension": {
      "enum": [
        "functions",
        "roles",
        "scenarios",
        "tags"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "taxonomy-node.schema.json"
      }
    }
  }
}
