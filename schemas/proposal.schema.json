{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JKwarn/AI-plugin-discovery-cn/main/schemas/proposal.schema.json",
  "title": "Taxonomy proposals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposals"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "kind",
        "status",
        "created_at",
        "description",
        "payload"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^proposal\\.[a-z0-9._-]+$"
        },
        "kind": {
          "enum": [
            "new_category",
            "category_change",
            "assignment"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "needs_revision"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
