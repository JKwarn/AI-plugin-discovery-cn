{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JKwarn/AI-plugin-discovery-cn/main/schemas/changelog.schema.json",
  "title": "分类变更日志",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "taxonomy_version", "effective_at", "type", "dimension", "category_ids", "summary"],
      "properties": {
        "change_id": {"type": "string", "pattern": "^change\\.[a-z0-9._-]+$"},
        "taxonomy_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "effective_at": {"type": "string", "format": "date"},
        "type": {"enum": ["add", "update", "rename", "reparent", "merge", "split", "deprecate", "archive"]},
        "dimension": {"enum": ["functions", "roles", "scenarios", "tags"]},
        "category_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "summary": {"type": "string", "minLength": 1},
        "details": {"type": "string"},
        "migration_id": {"type": "string", "pattern": "^migration\\.[a-z0-9._-]+$"}
      },
      "allOf": [{
        "if": {"properties": {"type": {"enum": ["merge", "split", "deprecate", "archive"]}}, "required": ["type"]},
        "then": {"required": ["migration_id"]}
      }]
    }
  }
}
